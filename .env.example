# =============================================================================
# MediMitra Production & Local Environment Configuration
# =============================================================================
# NEVER commit real production secrets, passwords, or tokens to version control.
# Copy this file to .env for local development or set variables in your cloud host.
# =============================================================================

# --- 1. Standalone Backend Server Configuration ---
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# --- 2. CORS Allowed Origins (Comma-separated) ---
# Add your GitHub Pages frontend origin (e.g. https://<username>.github.io)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://eshwarajaysai.github.io,https://neeharsiddani.github.io

# --- 3. Cryptographic Security & Authentication ---
# MANDATORY IN PRODUCTION: Backend fails closed if JWT_SECRET is empty in production.
# Generate a secure 32+ character random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_32_character_hex_secret_in_production
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# --- 4. Database Persistence (SQLite) ---
# IMPORTANT: In containerized deployments (Render, Railway, Fly.io, AWS), ensure
# this file resides on a persistent disk/volume mount so data survives redeployment.
DATABASE_PATH=./server/data/medimitra.db

# --- 5. Medical Document Storage ---
# Uploaded clinical PDF/image files reside in this directory.
# Requires persistent disk/volume storage across container redeployments.
UPLOAD_DIR=./server/uploads
MAX_FILE_SIZE_MB=10

# --- 6. OCR Service Engine ---
ENABLE_REAL_OCR=false
OCR_ENGINE=tesseract

# --- 7. ABDM Sandbox Gateway (NHA Sandbox Integration - Optional) ---
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=SBX_HEALTH_FACILITY_CLIENT_ID
ABDM_CLIENT_SECRET=SBX_HEALTH_FACILITY_SECRET_KEY
ABDM_HEALTH_FACILITY_ID=IN-TELANGANA-GGH-001

# --- 8. Temporary Hackathon / Demo Configuration ---
# Set to 'true' to re-enable 15-minute IP login lockout (30 attempts / 15 mins).
# Set to 'false' (default) during hackathons/demos to avoid lockout while testing accounts.
ENABLE_LOGIN_RATE_LIMIT=false


# =============================================================================
# Frontend Build Environment Variables (GitHub Pages / Vite)
# Set in GitHub Repository Secrets/Variables -> VITE_API_BASE_URL
# =============================================================================
# VITE_API_BASE_URL=https://your-backend-api-domain.com
# VITE_BASE_PATH=/Patient-Case/
